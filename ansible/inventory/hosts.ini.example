[web]
web1 ansible_host=<WEB1_PUBLIC_IP> ansible_user=ec2-user ansible_ssh_private_key_file=~/.ssh/<KEY_NAME>.pem

[monitoring]
monitoring1 ansible_host=<MONITORING_PRIVATE_IP> ansible_user=ec2-user ansible_ssh_private_key_file=~/.ssh/<KEY_NAME>.pem ansible_ssh_common_args='-o ProxyJump=ec2-user@<WEB1_PUBLIC_IP>'
